{
  "version": 2,
  "outputDirectory": "frontend/build",
  "framework": "create-react-app",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api/index.py" },
    { "source": "/(.*)", "destination": "frontend/$1" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,node_modules/**,public/**,static/**,build/**,.git/**,tests/**}"
    }
  }
}
